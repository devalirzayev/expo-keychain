{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "./build",
    "rootDir": "./src",
    "sourceMap": true,
    "tsBuildInfoFile": "./build/tsconfig.tsbuildinfo"
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*", "**/__rsc_tests__/*"],
  "references": [{ "path": "./plugin" }]
}
